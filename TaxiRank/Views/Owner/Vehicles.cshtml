@model TaxiRank.Models.ViewModels.OwnerVehicleListVM
@{
    ViewBag.Title = "My Vehicles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">My Vehicles</h3>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-9">
            <input class="form-control" name="search" value="@Model.Search" placeholder="Search by reg/make/model..." />
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr><th>Reg</th><th>Make/Model</th><th>Seats</th><th>Home Rank</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Rows)
                {
                    <tr>
                        <td>@v.RegNo</td>
                        <td>@(v.Make) @(v.Model)</td>
                        <td>@v.Seats</td>
                        <td>@v.HomeRank</td>
                        <td>
                            <span class="badge @(v.Active ? "text-bg-success":"text-bg-secondary")">@(v.Active ? "Active" : "Inactive")</span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" href="@Url.Action("VehicleDetail", new { id = v.VehicleId })">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
