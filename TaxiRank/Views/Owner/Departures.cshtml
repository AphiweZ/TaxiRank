@model TaxiRank.Models.ViewModels.OwnerDeparturesVM
@{
    ViewBag.Title = "Departures";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mapsKey = System.Configuration.ConfigurationManager.AppSettings["GoogleMapsApiKey"];

    // Prepare destination points JSON in-scope
    string ptsJson = "[]";
    if (!string.IsNullOrWhiteSpace(mapsKey))
    {
        // Build destination points by looking up route lat/lng
        var pts = new List<object>();
        using (var db = new TaxiRank.Models.TaxiRankDb3Entities2())
        {
            var ids = Model.Rows.Select(r => r.DepartureId).ToList();
            foreach (var depId in ids)
            {
                var dep = db.Departures.FirstOrDefault(x => x.DepartureId == depId);
                if (dep != null)
                {
                    var route = db.Routes.FirstOrDefault(r => r.RouteId == dep.RouteId);
                    if (route != null && route.ToLatitude.HasValue && route.ToLongitude.HasValue)
                    {
                        pts.Add(new
                        {
                            lat = (double)route.ToLatitude.Value,
                            lng = (double)route.ToLongitude.Value,
                            name = route.ToName
                        });
                    }
                }
            }
        }
        ptsJson = Newtonsoft.Json.JsonConvert.SerializeObject(pts);
    }
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Departures</h3>
    </div>

    <div class="row g-3">
        <div class="col-lg-12">
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Time</th><th>Route</th><th>Vehicle</th><th>Booked</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Rows)
                        {
                            <tr>
                                <td>@d.Date.ToString("yyyy-MM-dd")</td>
                                <td>@d.PlannedTime</td>
                                <td>@d.RouteName</td>
                                <td>@d.VehicleReg</td>
                                <td>@d.SeatsBooked / @d.SeatsTotal</td>
                                <td>@d.Status</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-dark" href="@Url.Action("DepartureDetail", new { id = d.DepartureId })">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    
       
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mapsKey))
{
    <script src="https://maps.googleapis.com/maps/api/js?key=@mapsKey"></script>
    <script>
    (function(){
        var points = @Html.Raw(ptsJson);
        function init(){
            var el = document.getElementById("dep-map");
            if(!el) return;
            var center = points.length ? {lat: points[0].lat, lng: points[0].lng} : {lat:-28.5,lng:24.7};
            var map = new google.maps.Map(el, {zoom: points.length?6:5, center:center});
            for (var i=0;i<points.length;i++){
                new google.maps.Marker({map:map, position:{lat:points[i].lat, lng:points[i].lng}, title: points[i].name});
            }
        }
        if (window.google && google.maps){ init(); }
        else { window.addEventListener("load", init); }
    })();
    </script>
}
