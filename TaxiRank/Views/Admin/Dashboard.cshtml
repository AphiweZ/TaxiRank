@model TaxiRank.Models.ViewModels.DashboardVM
@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Admin Dashboard</h2>
            <p class="text-muted">Welcome to the administrative control panel. Use the tools below to manage users and system settings.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 transition-card">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title text-dark">User Management</h5>
                    <p class="card-text text-muted">View, edit, and manage registered users.</p>
                    <a href="@Url.Action("UsersList")" class="btn btn-outline-primary mt-3">Manage Users</a>
                </div>
            </div>
        </div>

        <!-- Add more cards here for other dashboard actions -->
    </div>
</div>

<style>
    .transition-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
        transform: translateY(-2px);
        transition: all 0.3s ease-in-out;
    }
</style>