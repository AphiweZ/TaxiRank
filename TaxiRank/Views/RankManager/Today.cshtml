@model TaxiRank.Models.ViewModels.DepartureListVM
@{
    ViewBag.Title = "Today";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Today’s Departures</h3>
        <div>
            <a class="btn btn-sm btn-success" href="@Url.Action("CreateDeparture")">New Departure</a>
        </div>
    </div>

    <form class="row g-2 mb-3" method="get">
        <div class="col-auto">
            <select class="form-select" name="rankId">
                <option value="">All ranks</option>
                @foreach (var r in Model.RankOptions)
                {
                    <option value="@r.Id">@r.Name</option>
}
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select" name="status">
                <option value="">Any status</option>
                @foreach (var s in Model.StatusOptions)
                {
                    <option value="@s.Name">@s.Name</option>
}
            </select>
        </div>
        <div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light"><tr><th>Time</th><th>Route</th><th>Vehicle</th><th>Driver</th><th>Booked</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    <tr>
                        <td>@d.PlannedTime</td>
                        <td>@d.RouteName</td>
                        <td>@d.VehicleReg</td>
                        <td>@d.DriverName</td>
                        <td>@d.SeatsBooked / @d.SeatsTotal</td>
                        <td>@d.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
