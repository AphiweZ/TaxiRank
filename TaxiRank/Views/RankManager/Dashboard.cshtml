@model TaxiRank.Models.ViewModels.RankDashboardVM
@{
    ViewBag.Title = "Rank Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mapsKey = System.Configuration.ConfigurationManager.AppSettings["GoogleMapsApiKey"];

    string ptsJson = "[]";
    if (!string.IsNullOrWhiteSpace(mapsKey) && Model.Departures != null)
    {
        using (var db = new TaxiRank.Models.TaxiRankDb3Entities2())
        {
            var dests = new List<object>();
            foreach (var dep in Model.Departures.Take(20))
            {
                var depRow = db.Departures.FirstOrDefault(x => x.DepartureId == dep.DepartureId);
                if (depRow == null)
                {
                    continue;
                }
                var route = db.Routes.FirstOrDefault(r => r.RouteId == depRow.RouteId);
                if (route != null && route.ToLatitude.HasValue && route.ToLongitude.HasValue)
                {
                    dests.Add(new { lat = (double)route.ToLatitude.Value, lng = (double)route.ToLongitude.Value, name = route.ToName });
                }
            }
            ptsJson = Newtonsoft.Json.JsonConvert.SerializeObject(dests);
        }
    }
}

<div class="container py-3">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
        <div>
            <h2 class="mb-1">Rank Dashboard</h2>
            <div class="text-muted">Today: @Model.Date.ToString("yyyy-MM-dd")</div>
            <div class="mt-2 d-flex gap-2">
                <a href="@Url.Action("EventRequests","RankManager")" class="btn btn-success btn-sm">Event Requests</a>
                <a href="@Url.Action("EventRequests","RankManager", new { status = "Approved" })" class="btn btn-outline-primary btn-sm">Approved Events</a>
            </div>
        </div>
        <form method="get" class="row g-2">
            <div class="col-auto">
                <select class="form-select" name="rankId">
                    <option value="">All ranks</option>
                    @foreach (var r in Model.RankOptions)
                    {
                        <option value="@r.Id" @(Model.RankId == r.Id ? "selected" : "")>@r.Name</option>
}
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary">Apply</button>
            </div>
        </form>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@Model.TotalDepartures</div><div class="text-muted">Total Today</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@Model.BoardingCount</div><div class="text-muted">Boarding</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@Model.ReadyCount</div><div class="text-muted">Ready</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@Model.DepartedCount</div><div class="text-muted">Departed</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Today’s Departures</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Route</th>
                                <th>Vehicle</th>
                                <th>Driver</th>
                                <th>Booked</th>
                                <th>Status</th>
                               
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Departures)
                            {
                                <tr>
                                    <td>@d.PlannedTime</td>
                                    <td>@d.RouteName</td>
                                    <td>@d.VehicleReg</td>
                                    <td>@d.DriverName</td>
                                    <td>@d.SeatsBooked / @d.SeatsTotal</td>
                                    <td>
                                        @{
                                            // Use Bootstrap badges to style the status for better readability
                                            var statusClass = "bg-secondary";
                                            if (d.Status == "Departed") { statusClass = "bg-success"; }
                                            else if (d.Status == "Boarding") { statusClass = "bg-primary"; }
                                            else if (d.Status == "Ready") { statusClass = "bg-info"; }
                                            else if (d.Status == "Cancelled") { statusClass = "bg-danger"; }
                                        }
                                        <span class="badge @statusClass">@d.Status</span>
                                    </td>
                                   
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

