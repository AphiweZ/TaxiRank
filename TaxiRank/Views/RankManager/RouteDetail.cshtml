@model TaxiRank.Models.ViewModels.RouteDetailVM
@{
    ViewBag.Title = "Route Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@Model.FromRank → @Model.ToName</h3>
        @using (Html.BeginForm("RouteToggle", "RankManager", new { id = Model.RouteId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-warning">@(Model.Active ? "Deactivate" : "Activate")</button>
        }
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Waypoints</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>#</th><th>Name</th><th>Lat</th><th>Lng</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var w in Model.Waypoints)
                            {
                                <tr>
                                    <td>@w.Sequence</td>
                                    <td>@w.Name</td>
                                    <td>@w.Latitude</td>
                                    <td>@w.Longitude</td>
                                    <td class="text-end">
                                        @using (Html.BeginForm("WaypointRemove", "RankManager", new { id = w.RouteWaypointId }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("WaypointAdd", "RankManager", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("RouteId", Model.RouteId)
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4"><input name="Name" class="form-control" placeholder="Name" required /></div>
                            <div class="col-md-3"><input name="Latitude" class="form-control" type="number" step="0.000001" placeholder="Lat" /></div>
                            <div class="col-md-3"><input name="Longitude" class="form-control" type="number" step="0.000001" placeholder="Lng" /></div>
                            <div class="col-md-2"><input name="Sequence" class="form-control" type="number" placeholder="#" required /></div>
                            <div class="col-12 mt-2"><button class="btn btn-primary">Add Waypoint</button></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Fare Rules</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Type</th><th>Amount</th><th></thead>
                        <tbody>
                            @foreach (var f in Model.FareRules)
                            {
                                <tr>
                                    <td>@f.RuleType</td>
                                    <td>@f.Amount.ToString("0.00")</td>
                                    <td class="text-end">
                                        @using (Html.BeginForm("FareRuleRemove", "RankManager", new { id = f.FareRuleId }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("FareRuleAdd", "RankManager", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("RouteId", Model.RouteId)
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <select name="RuleType" class="form-select">
                                    <option>Base</option>
                                    <option>Peak</option>
                                    <option>Discount</option>
                                </select>
                            </div>
                            <div class="col-md-3"><input name="Amount" class="form-control" type="number" step="0.01" placeholder="Amount" required /></div>
                            <div class="col-md-3"><input name="StartDate" class="form-control" type="date" /></div>
                            <div class="col-md-3"><input name="EndDate" class="form-control" type="date" /></div>
                            <div class="col-12 mt-2"><button class="btn btn-primary">Add Rule</button></div>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col">
                            <div class="h4 mb-0">@Model.DefaultFare.ToString("0.00")</div>
                            <div class="text-muted">Default Fare</div>
                        </div>
                        <div class="col">
                            <div class="h4 mb-0">@Model.DistanceKm</div>
                            <div class="text-muted">Distance (km)</div>
                        </div>
                        <div class="col">
                            <div class="h4 mb-0">@(Model.Active ? "Active" : "Inactive")</div>
                            <div class="text-muted">Status</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
