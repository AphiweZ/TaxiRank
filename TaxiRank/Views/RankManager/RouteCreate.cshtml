@model TaxiRank.Models.ViewModels.RouteCreateVM
@{
    ViewBag.Title = "Create Route";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var decSep = System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator;
}
<div class="container py-3">
    <h3>Create Route</h3>
    @using (Html.BeginForm("RouteCreate", "RankManager", FormMethod.Post, new { id = "routeForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        <div class="row g-3">
            <div class="col-md-5">
                @Html.Label("From Rank")
                @Html.DropDownListFor(m => m.FromRankId, new SelectList(Model.RankOptions, "Id", "Name"), "-- select --", new { @class = "form-select", required = "required", id = "FromRankId" })
            </div>
            <div class="col-md-5">
                @Html.LabelFor(m => m.ToName, "To City")
                @Html.TextBoxFor(m => m.ToName, new { @class = "form-control", required = "required", autocomplete = "off", id = "ToName" })
                <div id="toNameHint" class="form-text">Start typing and choose a city result.</div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="Active" value="true" @(Model.Active ? "checked" : "") />
                    <label class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-md-4">
                @Html.Label("Place Id")
                @Html.TextBoxFor(m => m.ToPlaceId, new { @class = "form-control", id = "ToPlaceId", maxlength = "128" })
            </div>
            <div class="col-md-4">
                @Html.Label("Latitude")
                @Html.TextBoxFor(m => m.ToLatitude, new { @class = "form-control", id = "ToLatitude", inputmode = "decimal", placeholder = "-29,600000" })
            </div>
            <div class="col-md-4">
                @Html.Label("Longitude")
                @Html.TextBoxFor(m => m.ToLongitude, new { @class = "form-control", id = "ToLongitude", inputmode = "decimal", placeholder = "31,030000" })
            </div>

            <div class="col-md-4">
                @Html.LabelFor(m => m.DefaultFare)
                @Html.TextBoxFor(m => m.DefaultFare, new { @class = "form-control", type = "number", step = "0.01", id = "DefaultFare" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.DistanceKm)
                @Html.TextBoxFor(m => m.DistanceKm, new { @class = "form-control", type = "number", step = "0.1", id = "DistanceKm" })
            </div>

            <div class="col-12">
                <div id="map" class="border rounded" style="height:260px"></div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("RoutesList")">Cancel</a>
            </div>
        </div>
    }
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCzGOGXloVFr8w-Pe53rgPWuQv-P3KnIaE&libraries=places"></script>
<script>
(function(){
    var serverSep = "@decSep";
    var map, marker;

    function toServerDecimal(val){
        if(val==null) return "";
        var s=(""+val).trim().replace(",",".");
        var n=parseFloat(s);
        if(isNaN(n)) return "";
        var fixed=n.toFixed(6);
        return (serverSep === ",") ? fixed.replace(".", ",") : fixed;
    }

    function setLatLng(lat,lng,center){
        var latEl=document.getElementById("ToLatitude");
        var lngEl=document.getElementById("ToLongitude");
        if(latEl) latEl.value=toServerDecimal(lat);
        if(lngEl) lngEl.value=toServerDecimal(lng);
        if(map && marker){
            var latNum=parseFloat((""+latEl.value).replace(",","."));
            var lngNum=parseFloat((""+lngEl.value).replace(",","."));
            if(!isNaN(latNum) && !isNaN(lngNum)){
                var pos={lat:latNum,lng:lngNum};
                marker.setPosition(pos);
                if(center!==false){ map.setCenter(pos); map.setZoom(7); }
            }
        }
    }

    function initMap(){
        var el=document.getElementById("map"); if(!el) return;
        map=new google.maps.Map(el,{center:{lat:-28.5,lng:24.7},zoom:5});
        marker=new google.maps.Marker({map:map,position:map.getCenter(),draggable:true});
        google.maps.event.addListener(marker,"dragend",function(e){
            setLatLng(e.latLng.lat(), e.latLng.lng(), false);
        });
    }

    function initCityAutocomplete(){
        var input=document.getElementById("ToName"); if(!input) return;
        var ac=new google.maps.places.Autocomplete(input,{ types:['(cities)'] });
        google.maps.event.addListener(ac,'place_changed',function(){
            var p=ac.getPlace(); if(!p || !p.geometry) return;
            var cityName = p.name || (p.formatted_address || "").split(",")[0];
            input.value = cityName || input.value;
            var pidField=document.getElementById("ToPlaceId");
            if(pidField){ pidField.value=(p.place_id||"").toString().substring(0,128); }
            var lat=p.geometry.location.lat(), lng=p.geometry.location.lng();
            setLatLng(lat,lng,true);
        });
    }

    function beforeSubmit(e){
        var pid=document.getElementById("ToPlaceId");
        if(pid && pid.value.length>128) pid.value=pid.value.substring(0,128);
        var latEl=document.getElementById("ToLatitude");
        var lngEl=document.getElementById("ToLongitude");
        if(latEl) latEl.value=toServerDecimal(latEl.value);
        if(lngEl) lngEl.value=toServerDecimal(lngEl.value);
        var okLat=latEl && latEl.value && !isNaN(parseFloat(latEl.value.replace(",", ".")));
        var okLng=lngEl && lngEl.value && !isNaN(parseFloat(lngEl.value.replace(",", ".")));
        if(!okLat || !okLng){
            e.preventDefault();
            alert("Please choose a valid city so Latitude and Longitude are set.");
        }
    }

    window.addEventListener("load", function(){
        initMap();
        initCityAutocomplete();
        var f=document.getElementById("routeForm");
        if(f) f.addEventListener("submit", beforeSubmit);
    });
})();
</script>
