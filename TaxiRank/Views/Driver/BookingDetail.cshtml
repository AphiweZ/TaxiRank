@model TaxiRank.Models.ViewModels.BookingDetailVM
@{
    ViewBag.Title = "Booking Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">PNR @Model.Pnr</h3>
            <div class="text-muted">@Model.RouteName — @Model.DepartureDate.ToString("yyyy-MM-dd") @Model.PlannedTime</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Passenger & Seats</strong></div>
                <div class="card-body">
                    <div>Passenger: <strong>@Model.PassengerName</strong> &nbsp; <span class="text-muted">(@Model.PassengerPhone)</span></div>
                    <div>Seats: <strong>@Model.SeatsCount</strong> — [@string.Join(", ", Model.SeatNumbers)]</div>
                    <div>Total: <strong>@Model.ExtendedAmount.ToString("0.00")</strong></div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header"><strong>Payments</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.Payments)
                    {
                        <li class="list-group-item d-flex justify-content-between"><span>@p.PaidAt.ToString("g") — @p.Method</span><span>@p.Amount.ToString("0.00")</span></li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Actions</strong></div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" href="@Url.Action("DepartureDetail", new { id = ViewContext.RouteData.Values["id"] })">Back to Departure</a>
                </div>
            </div>
        </div>
    </div>
</div>
