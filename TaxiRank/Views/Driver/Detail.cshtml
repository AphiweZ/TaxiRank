@model TaxiRank.Models.ViewModels.DepartureDetailVM
@{
    ViewBag.Title = "Departure Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">@Model.RouteName — @Model.Date.ToString("yyyy-MM-dd") @Model.PlannedTime</h3>
            <div class="text-muted">Vehicle: @Model.VehicleReg • Min Fill: @Model.MinFill • Status: <span class="badge text-bg-dark">@Model.Status</span></div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("BookingCreate", "Driver", new { departureId = Model.DepartureId })" class="btn btn-primary">Create Booking</a>
            @using (Html.BeginForm("UpdateStatus", "Driver", new { id = Model.DepartureId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Boarding" />
                <button class="btn btn-outline-primary">Set Boarding</button>
            }
            @using (Html.BeginForm("UpdateStatus", "Driver", new { id = Model.DepartureId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Ready" />
                <button class="btn btn-outline-success">Set Ready</button>
            }
            @using (Html.BeginForm("UpdateStatus", "Driver", new { id = Model.DepartureId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Departed" />
                <button class="btn btn-outline-dark">Set Departed</button>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Seat Map</strong></div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var s in Model.SeatMap)
                        {
                            var cls = s.Status == "Free" ? "bg-success" : (s.Status == "Booked" ? "bg-secondary" : "bg-warning");
                            <div class="col-2"><span class="badge w-100 @cls">@s.SeatNo</span></div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Bookings</strong>
                    <span class="small text-muted">Click a confirmed PNR to open ticket</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>PNR</th><th>Passenger</th><th>Seats</th><th>Total</th><th>Status</th><th>Method</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in Model.Bookings)
                            {
                                <tr>
                                    <td>@b.Pnr</td>
                                    <td>@b.PassengerName</td>
                                    <td>@b.SeatsCount</td>
                                    <td>@b.ExtendedAmount.ToString("0.00")</td>
                                    <td>@b.Status</td>
                                    <td>@b.PaymentMethod</td>
                                    <td class="text-end">
                                        @if (b.Status == "Confirmed")
                                        {<a class="btn btn-sm btn-outline-dark" href="@Url.Action("Ticket", new { id = b.BookingId })">Ticket</a>}
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Payments</strong>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("PaymentsCsv", new { id = Model.DepartureId })">Export CSV</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead class="table-light"><tr><th>When</th><th>Amount</th><th>Method</th></tr></thead>
                                <tbody>
                                    @foreach (var p in Model.Payments)
                                    {
                                        <tr>
                                            <td>@p.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@p.Amount.ToString("0.00")</td>
                                            <td>@p.Method</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><strong>Expenses</strong></div>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead class="table-light"><tr><th>When</th><th>Type</th><th>Amount</th></tr></thead>
                                <tbody>
                                    @foreach (var e in Model.Expenses)
                                    {
                                        <tr>
                                            <td>@e.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@e.Type</td>
                                            <td>@e.Amount.ToString("0.00")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm("RecordExpense", "Driver", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="DepartureId" value="@Model.DepartureId" />
                                <div class="row g-2">
                                    <div class="col-6">
                                        <select name="Type" class="form-select">
                                            <option>Fuel</option>
                                            <option>Toll</option>
                                            <option>Fine</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                    <div class="col-6"><input name="Amount" type="number" step="0.01" class="form-control" placeholder="Amount" required /></div>
                                    <div class="col-8"><input name="proof" type="file" class="form-control" /></div>
                                    <div class="col-4 d-grid"><button class="btn btn-outline-primary">Add</button></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Ready Checklist</strong></div>
                <div class="card-body">
                    @using (Html.BeginForm("ReadyChecklist", "Driver", new { id = Model.DepartureId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="minFill" value="true" @(Model.MinFill > 0 ? "" : "") /><label class="form-check-label">Minimum Fill Reached</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="cashVerified" value="true" /><label class="form-check-label">Cash Verified</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="floatIssued" value="true" /><label class="form-check-label">Float Issued</label></div>
                        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="vehicleCleared" value="true" /><label class="form-check-label">Vehicle Cleared</label></div>
                        <button class="btn btn-outline-success">Save Checklist</button>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Cash-up</strong></div>
                <div class="card-body">
                    @using (Html.BeginForm("Cashup", "Driver", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="DepartureId" value="@Model.DepartureId" />
                        <div class="input-group">
                            <span class="input-group-text">ZAR</span>
                            <input class="form-control" name="CountedAmount" type="number" step="0.01" placeholder="Amount" required />
                            <button class="btn btn-outline-dark">Submit</button>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Verify Ticket</strong></div>
                <div class="card-body">
                    @using (Html.BeginForm("VerifyTicket", "Driver", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="departureId" value="@Model.DepartureId" />
                        <div class="input-group">
                            <input class="form-control" name="pnr" placeholder="Enter PNR" />
                            <button class="btn btn-outline-primary">Check</button>
                        </div>
                    }
                    @if (TempData["VerifyResult"] != null)
                    {
                        var r = TempData["VerifyResult"].ToString();
                        var cls = r == "Valid" ? "alert-success" : (r == "NotConfirmed" ? "alert-warning" : "alert-danger");
                        <div class="alert @cls mt-2 mb-0">Result: @r</div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header"><strong>Incidents</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-light"><tr><th>When</th><th>Type</th><th>Notes</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Incidents)
                            {
                                <tr>
                                    <td>@i.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@i.Type</td>
                                    <td class="text-truncate" style="max-width:180px">@i.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("LogIncident", "Driver", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="DepartureId" value="@Model.DepartureId" />
                        <div class="mb-2">
                            <select name="Type" class="form-select">
                                <option>Delay</option>
                                <option>Breakdown</option>
                                <option>RouteChange</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="mb-2"><textarea name="Notes" class="form-control" rows="2" placeholder="Notes"></textarea></div>
                        <div class="mb-2"><input type="file" name="photo" class="form-control" /></div>
                        <button class="btn btn-outline-danger">Report</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var badges = document.querySelectorAll(".badge");
        for (var i = 0; i < badges.length; i++) {
            badges[i].addEventListener("mouseenter", function () { this.style.transform = "scale(1.05)"; this.style.transition = "transform .1s"; });
            badges[i].addEventListener("mouseleave", function () { this.style.transform = ""; });
        }
    });
</script>