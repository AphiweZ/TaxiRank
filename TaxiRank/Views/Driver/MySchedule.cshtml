@model TaxiRank.Models.ViewModels.DriverScheduleVM
@{
    ViewBag.Title = "My Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">My Schedule</h3>
    </div>

    <form class="row g-2 mb-3" method="get">
     
        <div class="col-md-6">
            <input class="form-control" type="date" name="date"
                   value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-6">
            <button class="btn btn-outline-secondary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light"><tr><th>Date</th><th>Time</th><th>Route</th><th>Vehicle</th><th>Status</th><th>Booked</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    <tr>
                        <td>@d.Date.ToString("yyyy-MM-dd")</td>
                        <td>@d.PlannedTime</td>
                        <td>@d.RouteName</td>
                        <td>@d.VehicleReg</td>
                        <td>@d.Status</td>
                        <td>@d.SeatsBooked / @d.SeatsTotal</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" href="@Url.Action("Detail", new { id = d.DepartureId })">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>