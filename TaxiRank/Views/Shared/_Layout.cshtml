@using System.Web.Optimization
@{
    var isLoggedIn = Session["UserId"] != null && Convert.ToInt32(Session["UserId"]) > 0;
    var role = (Session["Role"] ?? "").ToString();
    var displayName = (Session["DisplayName"] ?? "Guest").ToString();
    var azure = "#007FFF";
    var dark1 = "#111111";
    var dark2 = "#222222";
    var dark3 = "#444444";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - TaxiRank</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <style>
        :root {
            --brand-azure: @azure;
            --ink-1: @dark1;
            --ink-2: @dark2;
            --ink-3: @dark3;
            --bg: #ffffff;
        }
        /* FONT CHANGE APPLIED HERE */
        html, body {
            background: var(--bg);
            color: var(--ink-1);
            font-family: Arial, Helvetica, sans-serif;
        }
        /* END FONT CHANGE */

        a { text-decoration: none; }
        .navbar { background: #ffffff; border-bottom: 1px solid #eef0f2; }
        .navbar .nav-link, .navbar-brand { color: var(--ink-2) !important; }
        .navbar .nav-link.active, .navbar .nav-link:hover { color: var(--brand-azure) !important; }
        .btn-brand { background: var(--brand-azure); color:#fff; }
        .btn-brand:hover { filter: brightness(0.95); color:#fff; }

        .badge-role { background: rgba(0,127,255,.1); color: var(--brand-azure); border: 1px solid rgba(0,127,255,.25); }
        .shadow-soft { box-shadow: 0 10px 25px rgba(0,0,0,.06); }

        .footer { background:#fff; border-top:1px solid #eef0f2; color: var(--ink-3); }
        .footer a { color: var(--ink-2); }
        .footer a:hover { color: var(--brand-azure); }

        .page-hero {
            background: linear-gradient(180deg, rgba(0,127,255,.04), transparent 60%);
            border-bottom: 1px solid #eef0f2;
        }


        @@media (max-width: 991.98px) {
            .navbar .dropdown-menu { border: none; box-shadow: none; }
        }

        @@keyframes floatIn {
            from { opacity:0; transform: translateY(6px) scale(.98); }
            to { opacity:1; transform: translateY(0) scale(1); }
        }
        [data-animate="float"] { animation: floatIn .45s ease both; }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top shadow-sm">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-semibold d-flex align-items-center" href="@Url.Action("Index","Home")" data-animate="float">
                Mzansi taxi Zone
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    @if (!isLoggedIn)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login","Account")">Sign in</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register","Account")">Register</a></li>
                    }

                    @if (isLoggedIn && role == "Customer")
                    {
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString()=="Customer" ? "active" : "")" href="@Url.Action("Dashboard","Customer")"><i class="bi bi-speedometer2 nav-icon"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Search" && ViewContext.RouteData.Values["controller"]?.ToString()=="Customer" ? "active" : "")" href="@Url.Action("Search","Customer")"><i class="bi bi-search nav-icon"></i>Search</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="MyBookings" && ViewContext.RouteData.Values["controller"]?.ToString()=="Customer" ? "active" : "")" href="@Url.Action("MyBookings","Customer")"><i class="bi bi-ticket-perforated nav-icon"></i>My Bookings</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Profile" && ViewContext.RouteData.Values["controller"]?.ToString()=="Customer" ? "active" : "")" href="@Url.Action("Profile","Customer")"><i class="bi bi-person-circle nav-icon"></i>Profile</a></li>
                    }

                    @if (isLoggedIn && role == "Driver")
                    {
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString()=="Driver" ? "active" : "")" href="@Url.Action("Dashboard","Driver")"><i class="bi bi-speedometer2 nav-icon"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="MySchedule" ? "active" : "")" href="@Url.Action("MySchedule","Driver")"><i class="bi bi-calendar-week nav-icon"></i>My Schedule</a></li>
                    }

                    @if (isLoggedIn && role == "Owner")
                    {

                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString()=="Owner" ? "active" : "")" href="@Url.Action("Dashboard","Owner")"><i class="bi bi-speedometer2 nav-icon"></i>Dashboard</a></li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString()=="Owner" && (new[]{ "Vehicles","VehicleDetail" }.Contains(ViewContext.RouteData.Values["action"]?.ToString() ?? "")) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-ev-front nav-icon"></i>Vehicles
                            </a>

                            <ul class="dropdown-menu shadow-soft">
                                <li><a class="dropdown-item" href="@Url.Action("Vehicles","Owner")"><i class="bi bi-list-ul me-2"></i>List</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Assignments","Owner")"><i class="bi bi-people me-2"></i>Driver Assignments</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["action"]?.ToString()=="Departures" || ViewContext.RouteData.Values["action"]?.ToString()=="DepartureDetail" ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-sign-turn-right nav-icon"></i>Operations
                            </a>
                            <ul class="dropdown-menu shadow-soft">
                                <li><a class="dropdown-item" href="@Url.Action("Departures","Owner")"><i class="bi bi-clock-history me-2"></i>Departures</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Bookings","Owner")"><i class="bi bi-ticket-perforated me-2"></i>Bookings</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Incidents","Owner")"><i class="bi bi-shield-exclamation me-2"></i>Incidents</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["action"]?.ToString()=="Settlements" ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-cash-coin nav-icon"></i>Finance
                            </a>
                            <ul class="dropdown-menu shadow-soft">
                                <li><a class="dropdown-item" href="@Url.Action("Settlements","Owner")"><i class="bi bi-receipt me-2"></i>Settlements</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("PaymentsCsv","Owner")"><i class="bi bi-filetype-csv me-2"></i>Export Payments CSV</a></li>
                            </ul>
                        </li>
                    }

                    @if (isLoggedIn && (role == "RankManager" || role == "Conductor"))
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard","RankManager")"><i class="bi bi-speedometer2 nav-icon"></i>Dashboard</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(new[]{ "RanksList","RankCreate","RankEdit","RoutesList","RouteCreate","RouteDetail" }.Contains(ViewContext.RouteData.Values["action"]?.ToString() ?? "") ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-diagram-3 nav-icon"></i>Network
                            </a>
                            <ul class="dropdown-menu shadow-soft">
                                <li><a class="dropdown-item" href="@Url.Action("RanksList","RankManager")"><i class="bi bi-pin-map me-2"></i>Taxi Ranks</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("RoutesList","RankManager")"><i class="bi bi-signpost-2 me-2"></i>Routes</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("MapsSearch","RankManager")"><i class="bi bi-map me-2"></i>Maps Search</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(new[]{ "VehiclesList","VehicleCreate","VehicleEdit","DriverAssignmentCreate" }.Contains(ViewContext.RouteData.Values["action"]?.ToString() ?? "") ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-ev-front nav-icon"></i>Fleet
                            </a>
                            <ul class="dropdown-menu shadow-soft">
                                <li><a class="dropdown-item" href="@Url.Action("VehiclesList","RankManager")"><i class="bi bi-list-ul me-2"></i>Vehicles</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("VehicleCreate","RankManager")"><i class="bi bi-plus-square me-2"></i>Add Vehicle</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("DriverAssignmentCreate","RankManager")"><i class="bi bi-briefcase me-2"></i>Assign Driver</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Detail","RankManager", new { id = 0 })"><i class="bi bi-geo-alt nav-icon"></i>Active Departures</a></li>
                    }

                    @if (isLoggedIn && role == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard" && ViewContext.RouteData.Values["controller"]?.ToString()=="Admin" ? "active" : "")" href="@Url.Action("Dashboard","Admin")"><i class="bi bi-speedometer2 nav-icon"></i>Dashboard</a></li>
                     
                    }
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @if (isLoggedIn)
                    {
                        <span class="badge rounded-pill badge-role px-3 py-2" title="Current role">@role</span>
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-decoration-none text-body" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-4 me-2" style="color:var(--brand-azure)"></i>
                                <span class="fw-semibold">@displayName</span>
                                <i class="bi bi-chevron-down ms-2"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-soft">
                                @if (role == "Customer")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Profile","Customer")"><i class="bi bi-gear me-2"></i>Profile</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="@Url.Action("ResetPassword","Account")"><i class="bi bi-key me-2"></i>Change Password</a></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","Account")"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-brand" href="@Url.Action("Login","Account")"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <header class="page-hero">
        <div class="container py-3 py-lg-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h4 fw-bold mb-1" data-aos="fade-right">@ViewBag.Title</h1>
                    <div class="text-secondary small" data-aos="fade-right" data-aos-delay="50">South Africa’s minibus taxi ecosystem — bookings, ranks, routes & operations.</div>
                </div>

            </div>
        </div>
    </header>

    <main class="container my-4">
        <div class="shadow-soft rounded-3 p-3 p-md-4 bg-white" data-animate="float">
            @RenderBody()
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="small">
                <span class="fw-semibold">Mzansi Taxi Zone</span> · © @DateTime.Now.Year
            </div>
            <div class="small">
                <i class="bi bi-geo-alt-fill me-1"></i> Durban Station, Durban ·
                <i class="bi bi-telephone-outbound me-1 ms-2"></i> +27 10 555 0101 ·
                <i class="bi bi-envelope-at me-1 ms-2"></i> durbanstationassociation@gmail.com
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            AOS.init({ duration: 600, once: true, easing: "ease-out" });
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>