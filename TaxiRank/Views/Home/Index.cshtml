@{
    ViewBag.Title = "Welcome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .hero {
        background: radial-gradient(1200px 600px at 10% -10%, rgba(99,102,241,.25), rgba(255,255,255,0)) ,
                    radial-gradient(1200px 600px at 110% 10%, rgba(16,185,129,.22), rgba(255,255,255,0)),
                    linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }
    .hero-lg {
        min-height: 64vh;
        display: grid;
        place-items: center;
        border-radius: 1.25rem;
    }
    .floating {
        animation: float 6s ease-in-out infinite;
    }
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    .brand-badge {
        display:inline-flex; align-items:center; gap:.5rem; padding:.35rem .75rem;
        background:#111827; color:#fff; border-radius:999px; font-weight:600; letter-spacing:.2px;
        box-shadow:0 8px 24px rgba(0,0,0,.18);
    }
    .soft-shadow { box-shadow: 0 10px 25px rgba(0,0,0,.06); }
    .section-h { letter-spacing:.2px }
    .feature-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,0,0,.12); }
    .feature-card { transition: .25s ease; }
    .stat { font-size: clamp(1.75rem, 2.5vw, 2.25rem); font-weight: 800; }
    .bg-dots {
        background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
        background-size: 12px 12px; background-position: -10px -10px;
    }
</style>

<div class="container py-4 py-md-5">

    <div class="hero hero-lg soft-shadow mb-5 p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="brand-badge mb-3">
                    <img src="https://img.icons8.com/?size=512&id=8119&format=png" width="18" height="18" alt="van" />
                    TaxiRank
                </span>
                <h1 class="display-5 fw-bold mb-3">
                    Book seats. Track departures. Run your fleet.
                </h1>
                <p class="lead text-muted mb-4">
                    A modern platform for commuters, conductors, drivers, and owners—built for South African taxi ranks.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Register","Account")" class="btn btn-success btn-lg px-4">Get started</a>
                    <a href="@Url.Action("Login","Account")" class="btn btn-outline-dark btn-lg px-4">Sign in</a>
                </div>
                <div class="d-flex gap-4 mt-4">
                    <div>
                        <div class="stat">50k+</div>
                        <div class="text-muted">Seats managed</div>
                    </div>
                    <div>
                        <div class="stat">200+</div>
                        <div class="text-muted">Daily departures</div>
                    </div>
                    <div>
                        <div class="stat">99.9%</div>
                        <div class="text-muted">Uptime</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <img src="~/Content/images/South Africa taxis🇿🇦.jpg" class="img-fluid rounded-4 floating" alt="Commuters at a taxi rank" />
                    
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-center mb-4">
        <div class="col-lg-5 order-lg-2">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden soft-shadow">
                <img src="~/Content/images/Joburg Taxi Rank.jpg" class="w-100 h-100 object-fit-cover" alt="City maps" />
            </div>
        </div>
        <div class="col-lg-7 order-lg-1">
            <h2 class="section-h fw-bold mb-3">Everything you need—on one platform</h2>
            <p class="text-muted mb-4">
                Real-time seat management, quick booking, cash/card payments, driver assignments, incidents, telemetry trails, and smart reports.
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border bg-white feature-card">
                        <div class="fw-bold mb-1">For passengers</div>
                        <div class="text-muted">Find a route, reserve a seat, get your ticket instantly.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border bg-white feature-card">
                        <div class="fw-bold mb-1">For managers</div>
                        <div class="text-muted">Create departures, verify tickets, issue floats, and cash up.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border bg-white feature-card">
                        <div class="fw-bold mb-1">For drivers</div>
                        <div class="text-muted">Live seat map, incident logging, and daily schedules.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border bg-white feature-card">
                        <div class="fw-bold mb-1">For owners</div>
                        <div class="text-muted">Fleet overview, expenses, settlements, and net performance.</div>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <a href="@Url.Action("Register","Account")" class="btn btn-dark">Create a free account</a>
                <a href="@Url.Action("Login","Account")" class="btn btn-outline-secondary">I already have an account</a>
            </div>
        </div>
    </div>

    <div class="rounded-4 p-4 p-md-5 bg-dots mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-md-5">
                <h3 class="mb-3 fw-bold">Popular routes</h3>
                <p class="text-muted">Departures run all day across major corridors. Book ahead to secure your spot.</p>
                <ul class="list-unstyled">
                    <li class="mb-2"><span class="badge bg-dark me-2">1</span> Durban → Pietermaritzburg</li>
                    <li class="mb-2"><span class="badge bg-dark me-2">2</span> Durban → Umhlanga</li>
                    <li class="mb-2"><span class="badge bg-dark me-2">3</span> PMB → Durban</li>
                </ul>
                <a href="@Url.Action("Register","Account")" class="btn btn-success">Book a seat</a>
            </div>
            <div class="col-md-7">
                <div class="ratio ratio-16x9 rounded-4 overflow-hidden soft-shadow">
                    <img src="~/Content/images/SA.jpg" class="w-100 h-100 object-fit-cover" alt="Road" />
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-4 p-4 p-md-5 text-center soft-shadow" style="background: linear-gradient(135deg,#111827 0%, #1f2937 100%); color:#fff;">
        <h3 class="fw-bold mb-2">Ready to roll?</h3>
        <p class="mb-4 text-white-50">Create your free account and manage your trips in minutes.</p>
        <a href="@Url.Action("Register","Account")" class="btn btn-light btn-lg me-2">Get started</a>
        <a href="@Url.Action("Login","Account")" class="btn btn-outline-light btn-lg">Sign in</a>
    </div>

</div>
