@model TaxiRank.Models.ViewModels.BookingDetailVM
@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Checkout — PNR @Model.Pnr</h3>
            <div class="text-muted">@Model.RouteName — @Model.DepartureDate.ToString("yyyy-MM-dd") @Model.PlannedTime</div>
        </div>
        <img src="~/Content/images/tickets.jpg" class="rounded" style="height:56px" alt="Ticket" />
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Review</strong></div>
                <div class="card-body">
                    <div>Passenger: <strong>@Model.PassengerName</strong> — <span class="text-muted">@Model.PassengerPhone</span></div>
                    <div>Seats: <strong>@Model.SeatsCount</strong> — [@string.Join(", ", Model.SeatNumbers)]</div>
                    <div class="h5 mt-2">Total: <strong>@Model.ExtendedAmount.ToString("0.00") ZAR</strong></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Payment</strong></div>
                <div class="card-body d-flex flex-wrap gap-2">
                    @using (Html.BeginForm("ConfirmCard", "Customer", new { id = Model.BookingId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-success">Pay by Card</button>
                    }
                    @using (Html.BeginForm("Cancel", "Customer", new { id = Model.BookingId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger">Cancel Booking</button>
                    }
                    <a class="btn btn-outline-secondary" href="@Url.Action("Search")">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
