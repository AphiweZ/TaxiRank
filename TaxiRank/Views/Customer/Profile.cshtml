@model TaxiRank.Models.ViewModels.CustomerProfileVM
@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-3">
    <h3>My Profile</h3>
    @using (Html.BeginForm("Profile", "Customer", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-4">@Html.LabelFor(m => m.DisplayName)@Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control", required = "required" })</div>

          
            <div class="col-md-4">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new
                {
                    @class = "form-control",
                    required = "required",
                    type = "tel",         
                    maxlength = "10",     
                    pattern = "\\d{10}",    
                    title = "Phone number must be exactly 10 digits" 
                })
            </div>

            <div class="col-md-4">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })</div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard")">Cancel</a>
            </div>
        </div>
    }
</div>