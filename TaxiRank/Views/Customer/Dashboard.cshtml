@model TaxiRank.Models.ViewModels.CustomerDashboardVM
@{ ViewBag.Title = "My Dashboard";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

<link rel="preload" as="image" href="~/Content/images/taxis.jpeg" /> <div class="container py-3">
    <div class="row align-items-center mb-4"> <div class="col-md-7"> <h2 class="mb-1">Welcome to TaxiRank</h2> <div class="text-muted">Today: @Model.Date.ToString("yyyy-MM-dd")</div> <div class="mt-3 d-flex gap-2"> <a href="@Url.Action("RequestEvent","Customer")" class="btn btn-success btn-sm">Request Event Trip</a> <a href="@Url.Action("MyEvents","Customer")" class="btn btn-outline-primary btn-sm">My Event Bookings</a> <a href="@Url.Action("Search","Customer")" class="btn btn-outline-secondary btn-sm">Find Departures</a> </div> </div> <div class="col-md-5 text-md-end"> </div> </div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="@Url.Action("MyBookings")" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="fs-1 fw-bold">@Model.UpcomingBookings</div>
                        <div class="text-muted">Upcoming</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("MyBookings", new { status = "Confirmed" })" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="fs-1 fw-bold">@Model.TicketsConfirmedToday</div>
                        <div class="text-muted">Confirmed Today</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("MyBookings")" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="fs-1 fw-bold">@Model.CashPaidToday.ToString("0.00")</div>
                        <div class="text-muted">Paid Today (ZAR)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("Search")" class="text-decoration-none">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="fs-1 fw-bold">@Model.SuggestedDepartures.Count</div>
                        <div class="text-muted">Available Now</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="@Url.Action("RequestEvent","Customer")" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-body">
                        <div class="fs-5 fw-bold">Request Event</div>
                        <div class="text-muted small">Charters & group trips</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("MyEvents","Customer")" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-body">
                        <div class="fs-5 fw-bold">My Events</div>
                        <div class="text-muted small">Quotes, status & payments</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>My Recent Bookings</strong>
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("MyBookings")">View all</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>PNR</th><th>Passenger</th><th>Seats</th><th>Total</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @if (Model.MyRecentBookings.Any())
                            {
                                foreach (var b in Model.MyRecentBookings)
                                {
                <tr>
                    <td>@b.Pnr</td>
                    <td>@b.PassengerName</td>
                    <td>@b.SeatsCount</td>
                    <td>@b.ExtendedAmount.ToString("0.00")</td>
                    <td>@b.Status</td>
                    <td class="text-end">
                        @if (b.Status == "Confirmed")
                        {
    <a href="@Url.Action("Ticket", new { id = b.BookingId })" class="btn btn-sm btn-outline-dark">Ticket</a> }
                        else
                        {
    <a href="@Url.Action("Checkout", new { id = b.BookingId })" class="btn btn-sm btn-success">Pay</a>}
                    </td>
                </tr> }
                            }
                            else
                            {
                <tr><td colspan="6" class="text-center text-muted py-4">No recent bookings</td></tr>}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Suggested Departures</strong>
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Search")">Find more</a>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var d in Model.SuggestedDepartures)
                    {
        <li class="list-group-item d-flex align-items-center">
          
            <div>
                <div class="fw-bold">@d.RouteName — @d.Date.ToString("yyyy-MM-dd") @d.PlannedTime</div>
                <div class="small text-muted">@d.SeatsBooked / @d.SeatsTotal booked • @d.VehicleReg</div>
            </div>
            <a class="btn btn-sm btn-outline-dark ms-auto" href="@Url.Action("Book", new { departureId = d.DepartureId })">Book</a>
        </li>}
                </ul>
            </div>
        </div>
    </div>

</div>
<script>document.addEventListener("DOMContentLoaded", function () { var cards = document.querySelectorAll(".card"); for (var i = 0; i < cards.length; i++) { cards[i].addEventListener("mouseenter", function () { this.classList.add("shadow"); }); cards[i].addEventListener("mouseleave", function () { this.classList.remove("shadow"); }); } });</script>